<?xml version="1.0" encoding="utf-8"?>
<!-- آیکون 108×108dp — لوگو 62×19dp در مرکز
     corner distance = 32.4dp < safe radius 33dp (66dp safe zone spec)
     با این margin در هر لانچر round/square/circle کراپ نمیشود -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/splash_bg" />
        </shape>
    </item>
    <item
        android:top="44dp"
        android:bottom="44dp"
        android:left="23dp"
        android:right="23dp"
        android:drawable="@drawable/logo" />
</layer-list>
